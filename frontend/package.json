        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "jotai": "^3.0.1",
        "jotai-effect": "^2.4.1",
        "jotai-valtio": "^0.6.0",
        "json5": "^2.2.3",
        "lucide-react": "^1.49.0",
        "motion": "^13.5.0",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.6.7",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-resizable-panels": "^4.14.1",
        "react-use": "^17.6.1",
